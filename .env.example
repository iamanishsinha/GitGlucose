# ========================================================
# GitGlucose Environment Configuration Template
# ========================================================

# Server Configuration
PORT=8080
NODE_ENV=development

# --------------------------------------------------------
# GitHub API Authentication Mode Control
# --------------------------------------------------------
# Default development and production mode.
# NEVER change automatically.
GITHUB_AUTH_MODE=public

# Optional. Only used when GITHUB_AUTH_MODE=authenticated.
# IMPORTANT:
# GitGlucose does NOT automatically use GITHUB_TOKEN.
# Authentication must be explicitly enabled by the project owner.
GITHUB_TOKEN=

# --------------------------------------------------------
# Gemini AI Configuration (Optional)
# Falls back to deterministic roasts if not provided
# --------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=12000

# --------------------------------------------------------
# Cache & Rate Limiting Settings
# --------------------------------------------------------
GITHUB_CACHE_TTL_MS=600000
GITHUB_CACHE_MAX=200
RATE_LIMIT_PER_MINUTE=30
